{{!
    @template bbbext_bnx_datahub/dashboard

    The standalone DataHub activity dashboard.

    Example context (json):
    {
        "title": "DataHub dashboard",
        "intro": "Review attendance and engagement across your sessions.",
        "hasdata": true,
        "attendanceurl": "https://example.com/attendance.php?cmid=42",
        "engagementurl": "https://example.com/engagement.php?cmid=42",
        "attendanceaction": "View attendance",
        "engagementaction": "View engagement",
        "overalltitle": "Overall summary",
        "excludedurl": "https://example.com/excluded.php?cmid=42",
        "excludedlabel": "Excluded sessions (0)",
        "metrics": [
            {
                "label": "Sessions held",
                "value": 5
            }
        ],
        "attendancechart": "<div>Attendance chart</div>",
        "engagementchart": "<div>Engagement chart</div>",
        "learnerchart": "<div>Learner participation chart</div>",
        "session": {
            "sessiontitle": "Session summary",
            "selectedsession": {
                "name": "Introduction to Statistics",
                "date": "Monday, 22 September 2026, 10:00 AM",
                "duration": "1 hour"
            },
            "sessionfragmenturl": "https://example.com/session.php?cmid=42",
            "cmid": 42,
            "sessionselectorlabel": "Session",
            "sessions": [
                {
                    "id": 17,
                    "label": "Introduction to Statistics - 22 September 2026",
                    "selected": true
                }
            ],
            "sessionselectaction": "Show",
            "learnerchart": "<div>Learner participation chart</div>",
            "sessionmetrics": [
                {
                    "value": 24,
                    "label": "Participants"
                }
            ],
            "hasattendees": false,
            "noattendees": "No learner attendance was recorded for this session."
        },
        "emptytitle": "No meeting insights yet",
        "emptytext": "Meeting insights will appear here after BigBlueButton sends analytics for a completed session."
    }
}}
<section class="bbbext-bnx-datahub-dashboard" aria-labelledby="bbbext-bnx-datahub-dashboard-title">
    <header class="bbbext-bnx-datahub-dashboard__header">
        <div>
            <h2 id="bbbext-bnx-datahub-dashboard-title">{{title}}</h2>
            <p>{{intro}}</p>
        </div>
        <nav class="bbbext-bnx-datahub-dashboard__actions" aria-label="{{title}}">
            <a class="btn btn-outline-primary" href="{{attendanceurl}}">{{attendanceaction}}</a>
            <a class="btn btn-primary" href="{{engagementurl}}">{{engagementaction}}</a>
        </nav>
    </header>

    <div class="bbbext-bnx-datahub-dashboard__summary-header">
        <h3>{{overalltitle}}</h3>
        <a href="{{excludedurl}}">{{excludedlabel}}</a>
    </div>

    {{#hasdata}}
        <div class="bbbext-bnx-datahub-dashboard__metrics">
            {{#metrics}}
                <div class="bbbext-bnx-datahub-dashboard__metric">
                    <span class="bbbext-bnx-datahub-dashboard__metric-value">{{value}}</span>
                    <span class="bbbext-bnx-datahub-dashboard__metric-label">{{label}}</span>
                </div>
            {{/metrics}}
        </div>

        <div class="bbbext-bnx-datahub-dashboard__charts">
            <section class="bbbext-bnx-datahub-dashboard__chart" aria-label="{{attendanceaction}}">
                {{{attendancechart}}}
            </section>
            <section class="bbbext-bnx-datahub-dashboard__chart" aria-label="{{engagementaction}}">
                {{{engagementchart}}}
            </section>
        </div>

        <section class="bbbext-bnx-datahub-dashboard__session" data-region="bbbext-bnx-datahub-session"
            aria-labelledby="bbbext-bnx-datahub-session-title">
            {{#session}}
                {{> bbbext_bnx_datahub/session}}
            {{/session}}
        </section>
    {{/hasdata}}

    {{^hasdata}}
        <div class="alert alert-info" role="status">
            <h3>{{emptytitle}}</h3>
            <p class="mb-0">{{emptytext}}</p>
        </div>
    {{/hasdata}}
</section>
